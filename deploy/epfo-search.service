[Unit]
Description=EPFO establishment search web app
After=network-online.target
Wants=network-online.target

[Service]
User=epfo
WorkingDirectory=/opt/epfo-search
Environment=EPFO_HOST=127.0.0.1
Environment=EPFO_PORT=8765
ExecStart=/opt/epfo-search/.venv/bin/python epfo_web.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
